# EmailJS configuration for the Contact form (src/components/Contact/Contact.tsx).
#
# 1. Create a free account at https://www.emailjs.com, then add an email
#    service and a template with three variables: {{from_name}}, {{reply_to}},
#    and {{message}}.
# 2. Copy this file to `.env` and fill in the real values:
#      cp .env.example .env
# 3. Never commit `.env` with real keys (Vite inlines VITE_* vars into the
#    client bundle — treat the public key as public, but keep it out of git).
#
# If any of these is missing at runtime, the form renders a visible
# "Contact form isn't configured yet" notice and disables itself instead of
# pretending to send.

# EmailJS service ID (dashboard → Email Services), e.g. "service_abc1234"
VITE_EMAILJS_SERVICE_ID=

# EmailJS template ID (dashboard → Email Templates), e.g. "template_xyz5678"
VITE_EMAILJS_TEMPLATE_ID=

# EmailJS public key (dashboard → Account → General), e.g. "AbCdEfGhIjKlMnOp"
VITE_EMAILJS_PUBLIC_KEY=
